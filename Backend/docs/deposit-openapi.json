          },
          "403": {
            "description": "권한 없음"
          },
          "404": {
            "description": "없는 리소스 또는 타 고객사 리소스"
          },
          "409": {
            "description": "중복 취소 또는 requestKey 충돌"
          }
        },
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 10
            }
          }
        ]
      }
    },
    "/api/deposit/invoices/{id}/download": {
      "get": {
        "summary": "본인 고객사 PDF 다운로드",
