                          },
                          "type": {
                            "enum": [
                              "correction",
                              "topup",
                              "confirmed"
                            ]
                          },
                          "message": {
                            "type": "string"
                          },
                          "date": {
                            "type": "string"
                          },
                          "link": {
                            "type": [
                              "string",
                              "null"
                            ]
                          }
                        },
                        "required": [
                          "id",
                          "type",
                          "message",
                          "date",
                          "link"
                        ]
                      }
                    },
                    "page": {
                      "type": "integer"
                    },
                    "pageSize": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "items",
