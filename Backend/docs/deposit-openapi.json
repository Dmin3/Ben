          {
            "bearerAuth": []
          },
          {
            "accessCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "PDF 첨부파일",
            "content": {
              "application/pdf": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
